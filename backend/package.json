  },
  "devDependencies": {
    "@types/bcryptjs": "2.4.6",
    "@types/cors": "2.8.19",
    "@types/dockerode": "4.0.2",
    "@types/express": "5.0.6",
    "@types/jsonwebtoken": "9.0.10",
    "@types/node": "26.6.11",
    "@types/pg": "8.23.1",
    "@types/qrcode": "1.5.6",
